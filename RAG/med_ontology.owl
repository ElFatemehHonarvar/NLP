<?xml version="1.0"?>
<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
         xmlns:owl="http://www.w3.org/2002/07/owl#"
         xml:base="http://test.org/onto.owl"
         xmlns="http://test.org/onto.owl#">

<owl:Ontology rdf:about="http://test.org/onto.owl"/>

<owl:ObjectProperty rdf:about="#hasDisease">
  <rdfs:domain rdf:resource="#Patient"/>
  <rdfs:range rdf:resource="#Disease"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#hasSymptom">
  <rdfs:domain rdf:resource="#Disease"/>
  <rdfs:range rdf:resource="#Symptom"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#treatedBy">
  <rdfs:domain rdf:resource="#Disease"/>
  <rdfs:range rdf:resource="#Treatment"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#includesMedication">
  <rdfs:domain rdf:resource="#Treatment"/>
  <rdfs:range rdf:resource="#Medication"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#prescribedFor">
  <rdfs:domain rdf:resource="#Medication"/>
  <rdfs:range rdf:resource="#Disease"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#treats">
  <rdfs:domain rdf:resource="#Doctor"/>
  <rdfs:range rdf:resource="#Patient"/>
</owl:ObjectProperty>

<owl:DatatypeProperty rdf:about="#hasName">
  <rdfs:domain rdf:resource="#Doctor"/>
  <rdfs:domain rdf:resource="#Disease"/>
  <rdfs:domain rdf:resource="#Treatment"/>
  <rdfs:domain rdf:resource="#Medication"/>
  <rdfs:domain rdf:resource="#Patient"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#hasAge">
  <rdfs:domain rdf:resource="#Patient"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#hasGender">
  <rdfs:domain rdf:resource="#Patient"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#hasDescription">
  <rdfs:domain rdf:resource="#Symptom"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#hasDosage">
  <rdfs:domain rdf:resource="#Medication"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#hasSpecialization">
  <rdfs:domain rdf:resource="#Doctor"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</owl:DatatypeProperty>

<owl:Class rdf:about="#Patient">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#Disease">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#Symptom">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#Treatment">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#Medication">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#Doctor">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>


</rdf:RDF>
